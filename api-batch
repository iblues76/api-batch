    if not a.no_legend:
        print("  * processing   ! ended, not collected")


def cmd_models(a):
    """Free: what each provider offers. Never needs a project; prints paths, never key material."""
    usd = lambda x: "-" if x is None else f"{float(x):.3g}"
    ctx = lambda n: "-" if not n else (f"{n / 1e6:.3g}M" if n >= 1e6 else f"{round(n / 1000)}k")
    width = shutil.get_terminal_size((160, 24)).columns   # piped output is not clipped below 160
    for name in ([a.provider] if a.provider else list(PROVIDERS)):
        P = PROVIDERS[name]
        rows, notes = P.catalog(a.all)
        table = []
        for m, al, i, o, c, tags in sorted(rows, key=lambda r: r[0].lower()):
            both = i is not None and o is not None
            line = (m, al, usd(i), usd(o), f"{usd(i * P.batch)}/{usd(o * P.batch)}" if both else "-", ctx(c), tags)
            if not a.grep or a.grep.lower() in " ".join(line).lower():
                table.append(line)
        print(f"[{name}]  {len(table)} model{'s' * (len(table) != 1)}"
              f"{' matching ' + repr(a.grep) if a.grep else ''} | $ per MTok list | batch = {round((1 - P.batch) * 100)}% off"
              f" | default: {P.default_model}")
        for n in notes:
            print(f"  note: {n}")
        head = ("model", "alias", "in", "out", "batch in/out", "ctx", "tags")
        w = [max(len(r[k]) for r in [head] + table) for k in range(7)]
        over = sum(w) + 12 - (width - 1)                # six 2-space gaps; fit the terminal by clipping
        for col, floor in ((6, 19), (0, 40), (6, 1), (0, 16)):   # tags first, then long ids, then harder
            cut = max(min(over, w[col] - floor), 0)
            w[col] -= cut
            over -= cut
        clip = lambda t, n: t if len(t) <= n else t[:n - 1] + "…"
        if not table:
            print("  (none)\n")
            continue
        for r in [head] + table:
            print("  ".join([clip(r[0], w[0]).ljust(w[0]), r[1].ljust(w[1]), r[2].rjust(w[2]), r[3].rjust(w[3]),
                             r[4].rjust(w[4]), r[5].rjust(w[5]), clip(r[6], w[6])]).rstrip())
        print()


