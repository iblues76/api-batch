#!/usr/bin/env python3
"""api-batch — amux-style CLI for LLM batch jobs (50% off) with budget guard and cost ledger.

  api-batch init     <proj> --keyname <name> [--provider claude|deepinfra] [--dir ~/path] [--budget 50] [--target 30]
  api-batch add      <proj> <file>...            # .docx -> md (+images) via pandoc; .md/.txt/.pdf/.png copied
  api-batch ask      <proj> "question" ...       # append questions (or: api-batch ask proj -f file.txt)
  api-batch questions <proj>                     # list them
  api-batch estimate <proj> [--model --effort --max-tokens --web --now]   # FREE: tokens + worst-case $
  api-batch submit   <proj> [same opts]          # BILLS; refuses over budget, warns over target
                                                 #   --now = standard tier: runs immediately, 2x the price
  api-batch status   <proj>                      # last batch: state, counts, minutes
  api-batch cancel   <proj>                      # cancel the last batch (or --run <ts>); started requests may still bill
  api-batch collect  <proj>                      # answers -> runs/<ts>/qNN.md + usage.csv + ledger
  api-batch show     <proj> [q03]                # print the latest run's answers (or one)
  api-batch synth    <proj> "combine prompt"     # round 2: one request fed all collected answers
  api-batch ls [--all]                           # every project here (--all: + every trusted host)
  api-batch models [--provider P] [--grep TEXT] [--all]   # FREE: models each provider offers, prices, aliases
  api-batch host add|rm|ls <alias>               # trusted hosts for --all and deploy
  api-batch deploy   <host>...                   # install this script + venv on trusted hosts
  api-batch -H <host> <any command>              # run the command on that host

  api-batch config [show | set <key> <value>]   # key_dir, install_path, default_key, notify.url, notify.token_file

Providers (init --provider, fixed per project): claude (Anthropic, default; batch = 50% off) and
deepinfra (OpenAI-compatible Batch API; batch = 20% off).
Key: <key_dir>/<keyname>.key, mode 600 (key_dir defaults to ~/.config/api-batch/keys). Only the PATH
is stored; the value is never printed or put on a command line.
Model aliases: opus sonnet haiku fable (newest Fable, now 5.2) fable51. Costs are list-price ESTIMATES; the provider console is ground truth.

deepinfra: aliases flash (deepseek-ai/DeepSeek-V4.1-Flash-1017, the default) and dspro
(deepseek-ai/DeepSeek-V4-Pro-0813); any full DeepInfra model id is accepted too, one model per batch
(`api-batch models --provider deepinfra --grep deepseek` lists them with prices; tags: vision = multimodal).
  - key file: <key_dir>/deepinfra.key (init needs no --keyname); only submit/status/collect/cancel read it
  - text input only (.md/.txt); --effort does not apply (ignored) and --web is refused
  - estimate is APPROXIMATE: no token-count endpoint, so input = characters / 3
  - prices come from DeepInfra's public model list; a model with no known price is refused
"""
import argparse, base64, csv, datetime, json, mimetypes, os, shutil, subprocess, sys, time
from pathlib import Path

# ---------- self-contained venv: first run creates it and re-execs ----------
VENV = Path.home() / ".local/share/api-batch/venv"
if sys.prefix != str(VENV) and "--no-venv" not in sys.argv:
    py = VENV / "bin/python"
    if not py.exists():
        VENV.parent.mkdir(parents=True, exist_ok=True)
        uv = shutil.which("uv") or str(Path.home() / ".local/bin/uv")
        if Path(uv).exists():
            subprocess.run([uv, "venv", "-q", str(VENV)], check=True)
            subprocess.run([uv, "pip", "install", "-q", "--python", str(py), "anthropic", "openai"], check=True)
        else:
            subprocess.run([sys.executable, "-m", "venv", str(VENV)], check=True)
            subprocess.run([str(py), "-m", "pip", "install", "-q", "anthropic", "openai"], check=True)
        print(f"api-batch: created {VENV}", file=sys.stderr)
    os.execv(str(py), [str(py), os.path.abspath(__file__), *sys.argv[1:]])

import anthropic  # noqa: E402

CFG = Path.home() / ".config/api-batch/config.json"
DEFAULTS = {"projects": {}, "hosts": [], "key_dir": "~/.config/api-batch/keys",
            "install_path": "~/.local/bin/api-batch", "notify": {}}
BATCH = 0.5           # batch tier multiplier; --now uses 1.0
CACHE_WRITE_MULT = 1.25
WEB_PER_1K = 10.0


# ---------- provider layer ----------
class Claude:
    name = "claude"
    default_model, default_key, batch, uses_effort, approx = "opus", None, BATCH, True, ""
    aliases = {"opus": "claude-opus-5-5", "sonnet": "claude-sonnet-5-5",
               "haiku": "claude-haiku-5-5", "fable": "claude-fable-5-2",  # fable = newest Fable, always
               "fable51": "claude-fable-5-1"}
    prices = {  # USD per MTok, standard tier
        "claude-opus-5-5": (4.0, 20.0, 0.20), "claude-sonnet-5-5": (2.0, 10.0, 0.20),
        "claude-haiku-5-5": (0.10, 0.50, 0.01), "claude-fable-5-2": (8.0, 40.0, 0.20),
        "claude-fable-5-1": (10.0, 50.0, 0.25)}

    def __init__(self, key_file):
        p = Path(key_file).expanduser()
        if not p.is_file():
            die(f"key file not found: {p}  (put the key there, mode 600, on THIS machine)")
        self.c = anthropic.Anthropic(api_key=p.read_text().strip())

    def model(self, m):
        return self.aliases.get(m, m)

    def unknown(self, model):
        return f"unknown model {model}"

    def params(self, model, effort, max_tokens, web, content):
        p = {"model": model, "max_tokens": max_tokens, "output_config": {"effort": effort},
             "messages": [{"role": "user", "content": content}]}
        if web:
            p["tools"] = [{"type": "web_search_20260209", "name": "web_search", "max_uses": web}]
        return p

    def count(self, p):
        kw = {"model": p["model"], "messages": p["messages"]}
        if "tools" in p:
            kw["tools"] = p["tools"]
        return self.c.messages.count_tokens(**kw).input_tokens

    def submit(self, reqs):
        return self.c.messages.batches.create(requests=[{"custom_id": k, "params": v} for k, v in reqs.items()]).id

    def status(self, bid):
        b = self.c.messages.batches.retrieve(bid)
        rc = b.request_counts
        return b.processing_status, rc.succeeded, rc.errored + rc.expired + rc.canceled, rc.processing, b.ended_at

    def cancel(self, bid):
        b = self.c.messages.batches.cancel(bid)
        return b.processing_status, b.request_counts

    def results(self, bid):
        for r in self.c.messages.batches.results(bid):
            row = {"id": r.custom_id, "status": r.result.type, "stop": "", "text": "",
                   "in": 0, "out": 0, "cr": 0, "cw": 0, "web": 0}
            if r.result.type == "succeeded":
                m, u = r.result.message, r.result.message.usage
                stu = getattr(u, "server_tool_use", None)
                row.update(stop=m.stop_reason, text="".join(b.text for b in m.content if b.type == "text"),
                           **{"in": u.input_tokens, "out": u.output_tokens,
                              "cr": u.cache_read_input_tokens or 0, "cw": u.cache_creation_input_tokens or 0,
                              "web": (getattr(stu, "web_search_requests", 0) or 0) if stu else 0})
            elif r.result.type == "errored":
                row["stop"] = getattr(r.result.error, "type", "error")
            yield row

    @classmethod
    def catalog(cls, everything=False):
        """(rows, notes) for `models`: the provider's free model list when a key is here, else the built-in table."""
        alias = {}
        for a, m in cls.aliases.items():
            alias.setdefault(m, []).append(a)
        row = lambda m, ctx, tags: (m, ",".join(alias.get(m, [])), cls.prices.get(m, (None, None))[0],
                                    cls.prices.get(m, (None, None))[1], ctx, tags)
        builtin = [row(m, None, "built-in table") for m in cls.prices]
        name = cfg().get("default_key")
        if not name:
            return builtin, ["no default key set (api-batch config set default_key <name>): built-in alias table only"]
        kf = key_path(name)
        if not kf.is_file():
            return builtin, [f"key file not found on this machine: {kf} — built-in alias table only"]
        try:
            rows = []
            for m in cls(kf).c.models.list(limit=1000):
                d = m.model_dump()
                b = ((d.get("capabilities") or {}).get("batch") or {}).get("supported")
                rows.append(row(d["id"], d.get("max_input_tokens"), {True: "batch", False: "no-batch"}.get(b, "")))
            return rows, []
        except anthropic.APIError as e:
            return builtin, [f"could not list models ({type(e).__name__}) — built-in alias table only"]

    def cost(self, model, row, tier=BATCH):
        i, o, cr = self.prices[model]
        c = tier * (row["in"] * i + row["out"] * o + row["cr"] * cr + row["cw"] * i * CACHE_WRITE_MULT) / 1e6
        return c + row["web"] * WEB_PER_1K / 1000

    def worst(self, model, tin, n, max_tokens, web, tier=BATCH):
        i, o, _ = self.prices[model]
        return tier * (tin * i + n * max_tokens * o) / 1e6 + n * web * WEB_PER_1K / 1000

    def run_now(self, reqs):
        """Standard tier: run each request immediately (streaming, so long answers don't time out)."""
        for cid, p in reqs.items():
            row = {"id": cid, "status": "succeeded", "stop": "", "text": "", "in": 0, "out": 0, "cr": 0, "cw": 0, "web": 0}
            try:
                with self.c.messages.stream(**p) as st:
                    m = st.get_final_message()
                u, stu = m.usage, getattr(m.usage, "server_tool_use", None)
                row.update(stop=m.stop_reason, text="".join(b.text for b in m.content if b.type == "text"),
                           **{"in": u.input_tokens, "out": u.output_tokens,
                              "cr": u.cache_read_input_tokens or 0, "cw": u.cache_creation_input_tokens or 0,
                              "web": (getattr(stu, "web_search_requests", 0) or 0) if stu else 0})
            except anthropic.APIError as e:
                row.update(status="errored", stop=type(e).__name__)
            yield row


def need(mod):
    """Import a provider SDK; an older venv (made before that provider existed) gets it installed once."""
    import importlib
    try:
        return importlib.import_module(mod)
    except ImportError:
        if sys.prefix != str(VENV):
            die(f"python module '{mod}' is missing (pip install {mod})")
        uv = shutil.which("uv") or str(Path.home() / ".local/bin/uv")
        cmd = [uv, "pip", "install", "-q", "--python", sys.executable, mod] if Path(uv).exists() \
            else [sys.executable, "-m", "pip", "install", "-q", mod]
        if subprocess.run(cmd).returncode:
            die(f"could not install '{mod}' into {VENV}")
        print(f"api-batch: installed {mod} into {VENV}", file=sys.stderr)
        importlib.invalidate_caches()
        return importlib.import_module(mod)


class DeepInfra:
    """OpenAI-compatible Batch API: JSONL upload -> batch -> output file. Text only, one model per batch."""
    name = "deepinfra"
    base_url = "https://api.deepinfra.com/v1/openai"
    default_model, default_key, batch, uses_effort = "flash", "deepinfra", 0.8, False   # batch = 20% off list
    approx = "input tokens are APPROXIMATE (characters / 3; DeepInfra has no token-count endpoint)"
    aliases = {"flash": "deepseek-ai/DeepSeek-V4.1-Flash-1017",   # newest Flash
               "dspro": "deepseek-ai/DeepSeek-V4-Pro-0813"}
    builtin = {  # USD per MTok list price (in, out, cache read); used when the live model list is unreachable
        "deepseek-ai/DeepSeek-V4.1-Flash-1017": (0.20, 0.60, 0.006),
        "deepseek-ai/DeepSeek-V4-Pro-0813": (1.30, 2.60, 0.10)}
    price_cache = VENV.parent / "deepinfra-prices.json"

    def __init__(self, key_file):
        self.key_file, self._c, self._live, self.prices = Path(key_file).expanduser(), None, None, {}

    @property
    def c(self):
        """The client is made on first use: estimate needs no key, everything that talks to the API does."""
        if self._c is None:
            p = self.key_file
            if not p.is_file():
                die(f"key file not found: {p}  (put the DeepInfra key there, mode 600, on THIS machine)")
            if p.stat().st_mode & 0o077:
                die(f"key file {p} is readable by others — chmod 600 it")
            self._c = need("openai").OpenAI(api_key=p.read_text().strip(), base_url=self.base_url)
        return self._c

    def _lookup(self, model):
        """Price of a model: DeepInfra's public model list (no key), else the last price seen, else built in."""
        if self._live is None:
            import urllib.request
            try:
                req = urllib.request.Request(self.base_url + "/models", headers={"User-Agent": "api-batch"})
                data = json.loads(urllib.request.urlopen(req, timeout=15).read())["data"]
                self._live = {m["id"]: (m.get("metadata") or {}).get("pricing") or {} for m in data}
            except Exception:
                self._live = {}
        pr = self._live.get(model, {})
        if pr.get("input_tokens") is not None and pr.get("output_tokens") is not None:
            i, o = float(pr["input_tokens"]), float(pr["output_tokens"])
            price = (round(i, 6), round(o, 6), round(float(pr.get("cache_read_tokens") or i), 6))
            try:
                seen = json.loads(self.price_cache.read_text()) if self.price_cache.is_file() else {}
                seen[model] = price
                self.price_cache.write_text(json.dumps(seen, indent=1))
            except OSError:
                pass
            return price
        if self._live:        # the list answered and has no token price for this model: never guess
            return None
        try:
            seen = json.loads(self.price_cache.read_text())
        except (OSError, ValueError):
            seen = {}
        return tuple(seen[model]) if model in seen else self.builtin.get(model)

    @classmethod
    def catalog(cls, everything=False):
        """(rows, notes) for `models`, from DeepInfra's two public lists (no key): prices + context, and tags."""
        import urllib.request

        def get(url):
            req = urllib.request.Request(url, headers={"User-Agent": "api-batch"})
            return json.loads(urllib.request.urlopen(req, timeout=20).read())
        alias = {}
        for a, m in cls.aliases.items():
            alias.setdefault(m, []).append(a)
        try:
            oai = get(cls.base_url + "/models")["data"]
        except Exception as e:
            return ([(m, ",".join(alias.get(m, [])), p[0], p[1], None, "built-in table") for m, p in cls.builtin.items()],
                    [f"could not reach DeepInfra's model list ({type(e).__name__}) — built-in alias table only"])
        try:
            full = {m["model_name"]: m for m in get("https://api.deepinfra.com/models/list")}
        except Exception:
            full = {}
        keep = {"tools": "tools", "multimodal": "vision", "vision": "vision", "vlm": "vision",   # vision = multimodal
                "reasoning": "reason", "json": "json", "structured-output": "json", "prompt_cache": "cache"}
        rows = []
        for m in oai:
            meta, extra = m.get("metadata") or {}, full.get(m["id"], {})
            pr = meta.get("pricing") or {}
            kind = extra.get("type") or ("text-generation" if "chat" in (meta.get("tags") or []) else "other")
            if not everything and (kind != "text-generation" or pr.get("output_tokens") is None):
                continue
            have = {keep[t] for t in list(extra.get("tags") or []) + list(meta.get("tags") or []) if t in keep}
            tags = [t for t in ("tools", "vision", "reason", "json", "cache") if t in have]
            if everything and kind != "text-generation":
                tags.insert(0, kind)
            if extra.get("deprecated"):
                tags.append("deprecated")
            rows.append((m["id"], ",".join(alias.get(m["id"], [])), pr.get("input_tokens"), pr.get("output_tokens"),
                         meta.get("context_length") or extra.get("max_tokens"), " ".join(tags)))
        return rows, []

    def model(self, m):
        m = self.aliases.get(m, m)
        if m not in self.prices:
            price = self._lookup(m)
            if price:
                self.prices[m] = price
        return m

    def unknown(self, model):
        return (f"no known price for DeepInfra model '{model}' — refusing, so the budget guard stays honest. "
                f"Use an alias ({', '.join(self.aliases)}) or a full chat-model id from https://deepinfra.com/models")

    def _price(self, model):
        self.model(model)
        return self.prices.get(model) or die(self.unknown(model))

    def params(self, model, effort, max_tokens, web, content):
        if web:
            die("--web does not apply to the deepinfra provider (no server-side web search)")
        other = sorted({b["type"] for b in content if b["type"] != "text"})
        if other:
            die(f"the deepinfra provider is text only: input/ holds {', '.join(other)} files — keep .md/.txt only")
        return {"model": model, "max_tokens": max_tokens,     # effort is not sent: it does not apply here
                "messages": [{"role": "user", "content": "\n\n".join(b["text"] for b in content)}]}

    def count(self, p):
        return -(-sum(len(m["content"]) for m in p["messages"]) // 3)

    def submit(self, reqs):
        body = "".join(json.dumps({"custom_id": k, "method": "POST", "url": "/v1/chat/completions", "body": v}) + "\n"
                       for k, v in reqs.items()).encode()
        fid = self.c.files.create(file=("api-batch.jsonl", body), purpose="batch").id
        return self.c.batches.create(input_file_id=fid, endpoint="/v1/chat/completions", completion_window="24h").id

    @staticmethod
    def _counts(b):
        rc = b.request_counts
        total, ok, bad = (rc.total or 0, rc.completed or 0, rc.failed or 0) if rc else (0, 0, 0)
        return ok, bad, max(total - ok - bad, 0)

    def status(self, bid):
        b = self.c.batches.retrieve(bid)
        ok, bad, proc = self._counts(b)
        if b.status in ("completed", "failed", "expired", "cancelled"):
            end = b.completed_at or b.cancelled_at or b.expired_at or b.failed_at
            ended = datetime.datetime.fromtimestamp(end) if end else None
            if b.status != "completed":
                print(f"note: DeepInfra batch state is '{b.status}'", file=sys.stderr)
            return "ended", ok, bad + proc, 0, ended
        return b.status, ok, bad, proc, None

    def cancel(self, bid):
        import types
        b = self.c.batches.cancel(bid)
        ok, _, proc = self._counts(b)
        return b.status, types.SimpleNamespace(processing=proc, succeeded=ok, canceled=0)

    @staticmethod
    def _row(cid, body, error=None):
        row = {"id": cid, "status": "errored", "stop": "", "text": "", "in": 0, "out": 0, "cr": 0, "cw": 0, "web": 0}
        if error or not (body or {}).get("choices"):
            row["stop"] = str((error or {}).get("code") or ((body or {}).get("error") or {}).get("type") or "error")
            return row
        ch, u = body["choices"][0], body.get("usage") or {}
        cached = (u.get("prompt_tokens_details") or {}).get("cached_tokens") or 0
        stop = ch.get("finish_reason") or ""
        row.update(status="succeeded", stop="max_tokens" if stop == "length" else stop,
                   text=(ch.get("message") or {}).get("content") or "",   # reasoning text is not kept
                   **{"in": (u.get("prompt_tokens") or 0) - cached, "out": u.get("completion_tokens") or 0, "cr": cached})
        return row

    def results(self, bid):
        b = self.c.batches.retrieve(bid)
        fids = [x for x in (b.output_file_id, b.error_file_id) if x]
        if not fids:
            errs = "; ".join(str(e.message) for e in ((b.errors.data if b.errors else None) or [])) or "no detail given"
            die(f"batch {bid} is '{b.status}' with no output file: {errs}")
        for fid in fids:
            for line in self.c.files.content(fid).text.splitlines():
                if line.strip():
                    r = json.loads(line)
                    resp = r.get("response") or {}
                    yield self._row(r.get("custom_id"), resp.get("body"), r.get("error"))

    def cost(self, model, row, tier=0.8):
        i, o, cr = self._price(model)
        return tier * (row["in"] * i + row["out"] * o + row["cr"] * cr) / 1e6

    def worst(self, model, tin, n, max_tokens, web, tier=0.8):
        i, o, _ = self._price(model)
        return tier * (tin * i + n * max_tokens * o) / 1e6

    def run_now(self, reqs):
        """Standard tier: each request immediately through chat completions, at list price."""
        for cid, p in reqs.items():
            try:
                yield self._row(cid, self.c.chat.completions.create(**p, timeout=1800).model_dump())
            except need("openai").APIError as e:
                row = self._row(cid, None)
                row["stop"] = type(e).__name__
                yield row


PROVIDERS = {"claude": Claude, "deepinfra": DeepInfra}


# ---------- config / projects ----------
def die(msg):
    print(f"api-batch: {msg}", file=sys.stderr)
    sys.exit(1)


def cfg():
    c = json.loads(CFG.read_text()) if CFG.is_file() else {}
    return {**DEFAULTS, **c}


def key_path(keyname):
    if "/" in keyname:
        return Path(keyname).expanduser()
    return Path(cfg()["key_dir"]).expanduser() / f"{keyname}.key"


def save(c):
    CFG.parent.mkdir(parents=True, exist_ok=True)
    CFG.write_text(json.dumps(c, indent=1))


PROJ_DIR = None  # set by --dir / --pwd


def proj(name):
    projects = cfg()["projects"]
    if PROJ_DIR:
        want = Path(PROJ_DIR).expanduser().resolve()
        hits = [n for n, p in projects.items() if Path(p["dir"]).expanduser().resolve() == want]
        if not hits:
            die(f"no project registered at {want} (api-batch init <name> --dir {want})")
        if name and name not in hits:
            die(f"'{name}' is not the project at {want} ({hits[0]} is)")
        name = hits[0]
    if not name:
        die("project name required (or --dir PATH / --pwd)")
    p = projects.get(name) or die(f"no project '{name}' here (api-batch ls / init)")
    p["name"], p["path"] = name, Path(p["dir"]).expanduser()
    return p


def provider(p):
    return PROVIDERS[p.get("provider", "claude")](key_path(p["keyname"]))


def runs(p):
    return sorted(x.parent for x in (p["path"] / "runs").glob("*/batch.json"))


RUN = None  # set by --run <ts>


def last_run(p):
    r = runs(p) or die("no batch submitted yet")
    if RUN:
        r = [x for x in r if x.name.startswith(RUN)] or die(f"no run matching {RUN} (have: {', '.join(x.name for x in runs(p))})")
    return r[-1], json.loads((r[-1] / "batch.json").read_text())


def spent(p):
    led = p["path"] / "runs/ledger.csv"
    if not led.is_file():
        return 0.0
    with led.open() as f:
        return sum(float(r["cost_usd"]) for r in csv.DictReader(f))


# ---------- inputs ----------
def shared_blocks(p):
    blocks = []
    for f in sorted((p["path"] / "input").glob("*")):
        ext = f.suffix.lower()
        if ext in (".md", ".txt"):
            blocks.append({"type": "text", "text": f'<file name="{f.name}">\n{f.read_text()}\n</file>'})
        elif ext == ".pdf":
            blocks.append({"type": "document", "title": f.name, "source": {
                "type": "base64", "media_type": "application/pdf",
                "data": base64.b64encode(f.read_bytes()).decode()}})
        elif ext in (".png", ".jpg", ".jpeg", ".gif", ".webp"):
            blocks.append({"type": "text", "text": f"Image file: {f.name}"})
            blocks.append({"type": "image", "source": {"type": "base64", "data": base64.b64encode(f.read_bytes()).decode(),
                           "media_type": mimetypes.guess_type(f.name)[0] or "image/png"}})
    if blocks:
        blocks[-1]["cache_control"] = {"type": "ephemeral"}
    return blocks


def questions(p):
    q = p["path"] / "questions.txt"
    lines = [l.strip() for l in q.read_text().splitlines()] if q.is_file() else []
    return {f"q{i:02d}": l for i, l in enumerate((l for l in lines if l and not l.startswith("#")), 1)}


